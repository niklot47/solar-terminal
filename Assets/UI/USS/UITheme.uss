/*
 * UITheme.uss
 * Global design tokens. Override this file (or swap it at runtime) to
 * change the entire UI colour scheme — e.g. switch to red for combat mode.
 *
 * All other USS files reference only these variables, never raw colours.
 */

:root {
    /* --- Accent --- */
    --color-accent:          rgba(0, 210, 140, 1);      /* teal — primary highlight */
    --color-accent-dim:      rgba(0, 210, 140, 0.18);   /* tinted background */
    --color-accent-hover:    rgba(0, 255, 170, 1);

    /* --- Text --- */
    --color-text-primary:    rgba(220, 235, 230, 1);
    --color-text-secondary:  rgba(140, 170, 160, 1);
    --color-text-disabled:   rgba(80,  100,  95, 1);

    /* --- Surfaces --- */
    --color-bg-panel:        rgba(8,  18,  16, 0.92);
    --color-bg-item:         rgba(0,   0,   0, 0);
    --color-bg-item-hover:   rgba(0, 210, 140, 0.08);
    --color-bg-item-selected:rgba(0, 210, 140, 0.20);

    /* --- Borders --- */
    --color-border:          rgba(0, 210, 140, 0.22);
    --color-border-strong:   rgba(0, 210, 140, 0.55);

    /* --- Status colours (unchanged across themes) --- */
    --color-star:            rgba(255, 210,  80, 1);
    --color-planet:          rgba(100, 200, 120, 1);
    --color-moon:            rgba(130, 160, 155, 1);

    /* --- Typography --- */
    --font-size-label:       13px;
    --font-size-header:      11px;
    --font-size-small:       11px;

    /* --- Layout --- */
    --panel-width:           260px;
    --item-height:           34px;
    --indent-step:           18px;
    --border-radius:         2px;
    --transition-duration:   0.18s;
}

/* ------------------------------------------------------------------ */
/* Theme overrides — add class to root element to activate             */
/* ------------------------------------------------------------------ */

/* Default teal theme (same as :root defaults, explicit for clarity) */
.theme-default {
    --color-accent:           rgba(0, 210, 140, 1);
    --color-accent-dim:       rgba(0, 210, 140, 0.18);
    --color-accent-hover:     rgba(0, 255, 170, 1);
    --color-bg-panel:         rgba(8, 18, 16, 0.92);
    --color-bg-item-hover:    rgba(0, 210, 140, 0.08);
    --color-bg-item-selected: rgba(0, 210, 140, 0.20);
    --color-border:           rgba(0, 210, 140, 0.22);
    --color-border-strong:    rgba(0, 210, 140, 0.55);
    --color-text-primary:     rgba(220, 235, 230, 1);
    --color-text-secondary:   rgba(140, 170, 160, 1);
}

/* Combat / alert theme — red accent */
.theme-combat {
    --color-accent:           rgba(220, 50, 50, 1);
    --color-accent-dim:       rgba(220, 50, 50, 0.18);
    --color-accent-hover:     rgba(255, 80, 80, 1);
    --color-bg-panel:         rgba(20, 6, 6, 0.92);
    --color-bg-item-hover:    rgba(220, 50, 50, 0.08);
    --color-bg-item-selected: rgba(220, 50, 50, 0.22);
    --color-border:           rgba(220, 50, 50, 0.25);
    --color-border-strong:    rgba(220, 50, 50, 0.60);
    --color-text-primary:     rgba(235, 220, 220, 1);
    --color-text-secondary:   rgba(170, 130, 130, 1);
}

/* Amber / navigation theme */
.theme-nav {
    --color-accent:           rgba(220, 160, 30, 1);
    --color-accent-dim:       rgba(220, 160, 30, 0.18);
    --color-accent-hover:     rgba(255, 195, 60, 1);
    --color-bg-panel:         rgba(16, 14, 4, 0.92);
    --color-bg-item-hover:    rgba(220, 160, 30, 0.08);
    --color-bg-item-selected: rgba(220, 160, 30, 0.20);
    --color-border:           rgba(220, 160, 30, 0.22);
    --color-border-strong:    rgba(220, 160, 30, 0.55);
    --color-text-primary:     rgba(235, 230, 210, 1);
    --color-text-secondary:   rgba(170, 155, 110, 1);
}
